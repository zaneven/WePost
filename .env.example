# ==========================================
# WePost 环境变量配置模版
# 复制此文件为 .env 并按需填充真实密钥与配置
# ==========================================

# 基础应用配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=WePost
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# 鉴权与密钥配置
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here

# 数据库配置 (如 PostgreSQL / SQLite / MySQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wepost?schema=public
# 或者 SQLite: DATABASE_URL="file:./data/wepost.db"

# Redis 缓存与队列 (可选)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 微信公众平台 / 开放平台 API 配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_TOKEN=your_wechat_token
WECHAT_AES_KEY=your_wechat_encoding_aes_key

# AI 模型与推理服务 (如火山方舟 / OpenAI / Claude)
ARK_API_KEY=your_volcengine_ark_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# 对象存储与文件上传 (TOS / S3 / OSS / 本地存储)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# TOS / S3 配置
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ENDPOINT=

# 日志级别
LOG_LEVEL=info
